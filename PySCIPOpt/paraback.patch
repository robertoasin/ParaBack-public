+    def addConsExactLinear(self, vars, coefs, lhs=None, rhs=None, name="exactlinear"):
+        """
+        Adds an exact linear constraint  lhs <= sum_i coefs[i] * vars[i] <= rhs  (exact solving mode).
+
+        Parameters
+        ----------
+        vars : list of Variable
+        coefs : list of int, str or fractions.Fraction
+            exact coefficients (integers of any size are kept exactly)
+        lhs, rhs : int, str, fractions.Fraction or None
+            exact sides; None means -infinity / +infinity
+        name : str
+
+        Returns
+        -------
+        Constraint
+        """
+        if len(vars) != len(coefs):
+            raise ValueError("vars and coefs must have the same length")
+        cdef _VarArray wrapper = _VarArray(list(vars))
+        cdef int n = wrapper.size
+        cdef SCIP_RATIONAL** vals = <SCIP_RATIONAL**> malloc(max(n, 1) * sizeof(SCIP_RATIONAL*))
+        cdef SCIP_RATIONAL* rlhs = NULL
+        cdef SCIP_RATIONAL* rrhs = NULL
+        cdef SCIP_CONS* scip_cons
+        cdef int i
+        for i in range(n):
+            vals[i] = NULL
+        try:
+            for i in range(n):
+                PY_SCIP_CALL(SCIPrationalCreate(&vals[i]))
+                _set_rational(vals[i], coefs[i])
+            PY_SCIP_CALL(SCIPrationalCreate(&rlhs))
+            PY_SCIP_CALL(SCIPrationalCreate(&rrhs))
+            if lhs is None:
+                SCIPrationalSetNegInfinity(rlhs)
+            else:
+                _set_rational(rlhs, lhs)
+            if rhs is None:
+                SCIPrationalSetInfinity(rrhs)
+            else:
+                _set_rational(rrhs, rhs)
+            PY_SCIP_CALL(SCIPcreateConsBasicExactLinear(self._scip, &scip_cons, str_conversion(name), n,
+                                                        wrapper.ptr, vals, rlhs, rrhs))
+            PY_SCIP_CALL(SCIPaddCons(self._scip, scip_cons))
+            pycons = self._getOrCreateCons(scip_cons)
+            PY_SCIP_CALL(SCIPreleaseCons(self._scip, &scip_cons))
+            return pycons
+        finally:
+            for i in range(n):
+                if vals[i] != NULL:
+                    SCIPrationalFree(&vals[i])
+            free(vals)
+            if rlhs != NULL:
+                SCIPrationalFree(&rlhs)
+            if rrhs != NULL:
+                SCIPrationalFree(&rrhs)
+
