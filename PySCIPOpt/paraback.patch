+cdef _rational_text(value):
+    """Texto exacto de un int, str o fractions.Fraction (nunca un float: perdería precisión)."""
+    if isinstance(value, float):
+        raise TypeError("exact values must be int, str or fractions.Fraction, not float")
+    if hasattr(value, "numerator") and hasattr(value, "denominator") and not isinstance(value, int):
+        return f"{value.numerator}/{value.denominator}"
+    return str(value)
+
+
+cdef void _set_rational(SCIP_RATIONAL* r, value) except *:
+    text = _rational_text(value)
+    ctext = str_conversion(text)
+    if not SCIPrationalIsString(ctext):
+        raise ValueError(f"not a rational number: {text!r}")
+    SCIPrationalSetString(r, ctext)
+
+
+cdef _rational_to_str(SCIP_RATIONAL* r):
+    if SCIPrationalIsInfinity(r):
+        return "inf"
+    if SCIPrationalIsNegInfinity(r):
+        return "-inf"
+    cdef int size = SCIPrationalStrLen(r) + 2
+    cdef char* buffer = <char*> malloc(size)
+    try:
+        SCIPrationalToString(r, buffer, size)
+        return buffer.decode("utf-8")
+    finally:
+        free(buffer)
+
