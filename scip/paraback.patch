diff -ru a/src/rectlu/rectlu_factor.c b/src/rectlu/rectlu_factor.c
--- a/src/rectlu/rectlu_factor.c	2026-09-28 11:46:38.000000000 +0200
+++ b/src/rectlu/rectlu_factor.c	2026-11-20 10:25:23.000000000 +0100
@@ -49,9 +49,22 @@
 #pragma GCC diagnostic ignored "-Wpedantic"
 
 #ifdef SCIP_WITH_GMP
-static QSnum_type qsnum_zeroLpNum;
-static QSnum_type qsnum_oneLpNum;
-static QSnum_type __t__;
+/* ParaBack: these three rationals used to be plain globals initialized by every
+ * RECTLUbuildFactorization and freed by every RECTLUfreeFactorization.  With two SCIP instances
+ * in exact mode in the same process (e.g. two ParaBack workers as threads), the second
+ * initialization overwrote the first and the second free was a double free (heap corruption,
+ * found with valgrind).  They are now thread-local (__t__ is also a scratch variable of the
+ * elimination, which concurrent factorizations must not share) and reference counted, so they
+ * are initialized by the first live factorization and freed by the last one. */
+#if defined(_MSC_VER)
+#define QSNUM_THREADLOCAL __declspec(thread)
+#else
+#define QSNUM_THREADLOCAL __thread
+#endif
+static QSNUM_THREADLOCAL QSnum_type qsnum_zeroLpNum;
+static QSNUM_THREADLOCAL QSnum_type qsnum_oneLpNum;
+static QSNUM_THREADLOCAL QSnum_type __t__;
+static QSNUM_THREADLOCAL int qsnum_nfactorizations = 0;
 
 /** allocates memory */
 void *CGutil_allocrus (
@@ -86,9 +99,11 @@
    free(p);
 }
 
-/** initializes global zero and one */
+/** initializes global zero and one (only for the first live factorization of this thread) */
 void QSnum_factor_init (void)
 {
+   if( qsnum_nfactorizations++ > 0 )
+      return;
    QSnum_Init(qsnum_zeroLpNum);
    QSnum_Init(qsnum_oneLpNum);
    QSnum_Init(__t__);
@@ -96,9 +111,12 @@
    QSnum_SetOne(qsnum_oneLpNum);
 }
 
-/** frees global zero and one */
+/** frees global zero and one (only when the last live factorization of this thread is freed) */
 void QSnum_factor_clear (void)
 {
+   assert(qsnum_nfactorizations > 0);
+   if( --qsnum_nfactorizations > 0 )
+      return;
    QSnum_Clear(qsnum_zeroLpNum);
    QSnum_Clear(qsnum_oneLpNum);
    QSnum_Clear(__t__);
