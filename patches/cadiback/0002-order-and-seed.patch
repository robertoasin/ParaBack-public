 // support flipping we keep it under compile time control too (beside
 // allowing to disable it during run-time).
 
+// Reproducible shuffle for '--order=random:<seed>' (xorshift64, independent
+// of the C library; the permutation differs from ParaBack's Python one on
+// purpose: a different solver anyway).
+
+static unsigned long long order_rng;
+
+static unsigned long long next_random () {
+  unsigned long long x = order_rng;
+  x ^= x << 13;
+  x ^= x >> 7;
+  x ^= x << 17;
+  return order_rng = x;
+}
+
+// Build 'order' and 'position' once 'cand_vars' is known ('--order=<o>').
+// 'strided:<offset>/<stride>' takes first the candidates at positions
+// 'offset, offset+stride, ...' (as 'StridedOrder' in ParaBack) and then the
+// rest in index order.
+
+static void setup_order () {
+  order = new int[cand_vars + 1];
+  position = new int[vars + 2];
+  if (!order || !position)
+    fatal ("out-of-memory allocating candidate order");
+  for (int p = 0; p < cand_vars; p++)
+    order[p] = p + 1;
+  if (order_spec && *order_spec && strcmp (order_spec, "file")) {
+    if (!strcmp (order_spec, "reverse")) {
+      for (int p = 0; p < cand_vars; p++)
+        order[p] = cand_vars - p;
+    } else if (!strncmp (order_spec, "random:", 7)) {
+      order_rng = (unsigned long long) atoll (order_spec + 7) * 0x9E3779B97F4A7C15ull;
+      if (!order_rng)
+        order_rng = 0x2545F4914F6CDD1Dull;
+      for (int p = cand_vars - 1; p > 0; p--) {
+        int j = (int) (next_random () % (unsigned long long) (p + 1));
+        int tmp = order[p];
+        order[p] = order[j];
+        order[j] = tmp;
+      }
+    } else if (!strncmp (order_spec, "strided:", 8)) {
+      int offset = -1, stride = 0;
+      if (sscanf (order_spec + 8, "%d/%d", &offset, &stride) != 2 || offset < 0 || stride < 1)
+        die ("invalid option '--order=%s' (expected 'strided:<offset>/<stride>')", order_spec);
+      int p = 0;
+      for (int i = offset % stride; i < cand_vars; i += stride)
+        order[p++] = i + 1;
+      for (int i = 0; i < cand_vars; i++)
+        if (i % stride != offset % stride)
+          order[p++] = i + 1;
+      assert (p == cand_vars);
+    } else
+      die ("invalid option '--order=%s' (expected 'reverse', 'random:<seed>' or 'strided:<offset>/<stride>')", order_spec);
+  }
+  for (int idx = 0; idx <= vars + 1; idx++)
+    position[idx] = cand_vars; // not a candidate: nothing comes after it
+  for (int p = 0; p < cand_vars; p++)
+    position[order[p]] = p;
+}
