+// ParaBack worker mode: facts proven by other workers, read from '<stdin>'
+// between solver calls (never while assumptions or a constraint are pending).
+// A backbone found elsewhere is added as a unit and taken out of the
+// candidates without printing it; a refuted variable is just dropped.  Any
+// contradiction with what this worker has proven is fatal: the knowledge of
+// the portfolio would be inconsistent.
+
+static std::string paraback_input;
+
+static void paraback_contradiction (const char *what, int lit) {
+  printf ("e %s %d\n", what, lit);
+  fflush (stdout);
+  exit (1);
+}
+
+static void paraback_fact (const char *line) {
+  char command[16];
+  int value = 0;
+  if (sscanf (line, "%15s %d", command, &value) < 1)
+    return;
+  if (!strcmp (command, "stop")) {
+    printf ("s interrupted\n");
+    fflush (stdout);
+    exit (0);
+  }
+  int idx = abs (value);
+  if (!value || idx > cand_vars)
+    paraback_contradiction ("invalid", value);
+  if (!strcmp (command, "fix")) {
+    int lit = value;
+    solver->add (lit);
+    solver->add (0);
+    if (candidates[idx] == lit) {
+      fixed[idx] = lit;
+      candidates[idx] = 0;
+      statistics.backbones++;
+    } else if (fixed[idx] != lit)
+      paraback_contradiction ("fix", lit); // Dropped or opposite backbone.
+  } else if (!strcmp (command, "drop")) {
+    if (candidates[idx]) {
+      drop_tag = 'x';
+      drop_candidate (idx);
+      drop_tag = 'd';
+    } else if (fixed[idx])
+      paraback_contradiction ("drop", idx);
+  } else
+    paraback_contradiction ("unknown", value);
+}
+
+static void paraback_poll () {
+  if (!paraback_vars)
+    return;
+  if (paraback_interrupted) {
+    printf ("s interrupted\n");
+    fflush (stdout);
+    exit (0);
+  }
+  fflush (stdout);
+  char buffer[4096];
+  for (;;) {
+    ssize_t n = read (0, buffer, sizeof buffer);
+    if (n > 0) {
+      paraback_input.append (buffer, n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR)
+      continue;
+    break; // EAGAIN or end of input.
+  }
+  size_t start = 0, end;
+  while ((end = paraback_input.find ('\n', start)) != std::string::npos) {
+    paraback_fact (paraback_input.substr (start, end - start).c_str ());
+    start = end + 1;
+  }
+  paraback_input.erase (0, start);
+}
+
+class ParaBackTerminator : public CaDiCaL::Terminator {
+public:
+  bool terminate () override { return paraback_interrupted; }
+};
+
+static void paraback_on_sigint (int) { paraback_interrupted = 1; }
