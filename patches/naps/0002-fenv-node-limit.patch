+  // after the encoders had built the nodes; now every new node is checked against max_nodes
+  // (-max-nodes=<n>, at most 2^28), so Naps stops before a huge encoding exhausts memory.
+  // peak_nodes is reported with the statistics ("FEnv nodes peak").
+  extern unsigned max_nodes;
+  extern unsigned peak_nodes;
+  void nodes_overflow();
